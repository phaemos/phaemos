# Backend API URL - used by all frontend fetch calls
NEXT_PUBLIC_API_URL=http://localhost:8000

# Cloudflare Turnstile - public site key for the contact form widget
# Get from https://dash.cloudflare.com > Turnstile > Add Site
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX)
# Set in Vercel dashboard only - do NOT commit a real ID here
NEXT_PUBLIC_GA_ID=
