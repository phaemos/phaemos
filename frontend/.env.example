# backend API URL - used by all frontend fetch calls
NEXT_PUBLIC_API_URL=http://localhost:8000

# the public site and the dashboard on two addresses, served by this one deployment.
# Both unset or equal, means one address for everything (local development). Set both to different addresses to turn
# on "split mode": the site answers on NEXT_PUBLIC_SITE_URL, the dashboard and the sign-in pages on NEXT_PUBLIC_APP_URL
# and a request on the wrong address is redirected to the right one. Origins only, no path and no trailing slash.
# Read at build time and by the proxy at run time, so redeploy after changing them. On Vercel scope both to Production
# only. On a preview deployment they would link to the live site.
# NEXT_PUBLIC_SITE_URL=https://phaemos.com
# NEXT_PUBLIC_APP_URL=https://dashboard.phaemos.com
# NEXT_PUBLIC_APP_URL holds the dashboard's address. It keeps its name for compatibility.

# Cloudflare Turnstile - public site key for the contact form widget
# Get from https://dash.cloudflare.com > Turnstile > Add Site
# empty: the widget is not shown and the form sends no token (the API must allow that,
# which it does in development only). Set at build time: it also opens the
# content security policy to challenges.cloudflare.com.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX)
# Set in Vercel dashboard only - do NOT commit a real ID here
# empty: no analytics and no cookie banner. When set, analytics loads only after a visitor
# accepts the banner. The policy then allows googletagmanager.com and google-analytics.com.
NEXT_PUBLIC_GA_ID=

# Vercel Web Analytics - cookieless page view counts on the public site, off unless this is 1.
# It loads only on a Vercel production build. The privacy and cookie pages follow this value,
# so with this and NEXT_PUBLIC_GA_ID both empty the site loads no analytics and says so.
NEXT_PUBLIC_VERCEL_ANALYTICS=

# the hosted service is open to accounts. Leave empty until it is: the privacy notice and the terms then leave out the postal
# address and the ICO registration number. Set to 1 once it opens and the production build stops until both are filled in.
HOSTED_SERVICE_OPEN=
