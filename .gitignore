backend/ml/model.pkl.last.json

# Node
node_modules/
.next/
out/
.turbo/

# MkDocs build output - generated by mkdocs build, served from Vercel
/site/

# Docker
*.tar

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp

# Linting cache
.ruff_cache/

# Log files
*.log

# Arduino / PlatformIO build artefacts - generated by IDE, never commit binaries
*.elf
*.bin
*.hex
*.map

# Proteus design backup and simulation files - machine-generated, large
*.DBK
*.LKS
*.SDF

# ML training data exports - generated by train.py scripts, can be large
backend/ml/features.csv
backend/ml/telemetry.csv

# Rust
edge/target/

# PlatformIO build output and downloaded libraries
.pio/

# Secrets and server files that must never be committed
.env.production
.env.*.local
*.pem
*.key
# the one public certificate the Pico W firmware pins: a root certificate holds no secret
!firmware/pico_w/root_ca.pem
backups/
firmware_uploads/
firmware/esp32/secrets.h
firmware/pico_w/secrets.py
firmware/pico_w/boot_count.txt
phaemos-spool.jsonl*
# the development stack's generated signing key (make dev creates it)
infra/.env.dev
# encrypted backups and any age key file
*.age
age-key*.txt

# written by `next dev` on each start
frontend/AGENTS.md
*.tsbuildinfo
