# .env.example
# Copy this file to .env and fill in the values for your environment.
# Never commit the real .env file - it is in .gitignore.


# ---------------------------------------------------------------------------
# Database
# I use a single DATABASE_URL so any SQLAlchemy-compatible driver can be
# swapped in without changing application code.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://phaemos:phaemos@localhost:5432/phaemos


# ---------------------------------------------------------------------------
# Cache / message broker
# Redis is used for WebSocket pub/sub and caching frequently-read device state.
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379


# ---------------------------------------------------------------------------
# JWT authentication
# SECRET_KEY signs all access tokens - rotate it to invalidate all active sessions.
# I require a minimum of 32 characters to meet HS256 security guidelines.
# ---------------------------------------------------------------------------
SECRET_KEY=change-this-to-a-random-32-char-string-minimum
ALGORITHM=HS256
# 1440 minutes = 24 hours - reasonable for an internal dashboard
ACCESS_TOKEN_EXPIRE_MINUTES=1440


# ---------------------------------------------------------------------------
# CORS
# List of origins the browser is allowed to connect from.
# Separate multiple origins with commas, e.g. http://localhost:3000,https://app.phaemos.com
# ---------------------------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:3000


# ---------------------------------------------------------------------------
# Runtime environment
# Set to "production" in deployed environments to disable debug endpoints and
# enable stricter error handling.
# ---------------------------------------------------------------------------
ENVIRONMENT=development


# ---------------------------------------------------------------------------
# Discord alerts
# Leave empty to disable Discord notifications for critical alerts.
# ---------------------------------------------------------------------------
DISCORD_WEBHOOK_URL=


# ---------------------------------------------------------------------------
# Email (SMTP) alerts
# Leave SMTP_HOST empty to disable email notifications entirely.
# I use port 587 (STARTTLS) as the default because it is supported by most
# managed SMTP providers without firewall issues.
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Comma-separated list of recipient addresses for alert emails
ALERT_EMAIL_TO=


# ---------------------------------------------------------------------------
# Firmware OTA storage
# Local directory where uploaded firmware .bin files are stored before being
# served to devices. Create this directory before starting the server.
# ---------------------------------------------------------------------------
FIRMWARE_STORAGE_PATH=./firmware_uploads


# ---------------------------------------------------------------------------
# Anomaly detection thresholds
# ANOMALY_SCORE_THRESHOLD is the boundary above which a reading is flagged as
# anomalous in the UI. ANOMALY_CRITICAL_THRESHOLD triggers a high-severity alert.
# Both values must be between 0.0 and 1.0.
# ---------------------------------------------------------------------------
ANOMALY_SCORE_THRESHOLD=0.7
ANOMALY_CRITICAL_THRESHOLD=0.85
