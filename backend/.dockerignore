# Exclude Python caches and virtual environments from Docker build context
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.venv/
venv/

# Exclude local tooling metadata
.git
.gitignore
.vscode
.idea
.DS_Store
Thumbs.db

# Exclude local environment and logs
.env
*.log
logs/

# secrets never belong in the image: the production build runs in a folder that holds .env
.env
.env.*
!.env.example
