# Names only. Put the real values in your keychain or your shell for one command, never in a file.
# The script reads the environment and does not read this file.

# The bot token. Needed by every command that talks to Discord.
DISCORD_BOT_TOKEN=

# Optional. Only to pick between two servers that share a name.
DISCORD_GUILD_ID=

# Optional. The address of the commands worker. When set, apply points the application at it.
DISCORD_INTERACTIONS_URL=

# Tests only. Points the script at the fake API. Refused unless the host is localhost or 127.0.0.1.
DISCORD_API_BASE=
