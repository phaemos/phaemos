# EditorConfig - applied by most editors automatically.
# See https://editorconfig.org for documentation.

root = true

# Default rules for all files
[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
trim_trailing_whitespace = true
insert_final_newline = true

# Python files use 4-space indentation per PEP 8
[*.py]
indent_size = 4

# Markdown: preserve trailing whitespace (two spaces = hard line break)
[*.md]
trim_trailing_whitespace = false

# YAML files used for config and GitHub Actions workflows
[*.{yml,yaml}]
indent_size = 2

# C and C++ firmware files
[*.{c,h,cpp,ino}]
indent_size = 4
